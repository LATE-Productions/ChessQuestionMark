
{
  "version": "0.2.0", 
  "configurations": [
    {
      "name": "Run EXE",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/Debug/marker_pipeline.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal"
  },
    {
      "name": "Attach to Godot (GDExtension)",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "symbolSearchPath": "${workspaceFolder}/bin;${workspaceFolder}",
      "requireExactSource": false,
      "logging": {
        "moduleLoad": true,
        "engineLogging": true
      }
    }
  ]
}
