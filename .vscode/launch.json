
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Godot (GDExtension)",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "symbolSearchPath": "${workspaceFolder}/bin;${workspaceFolder}",
      "requireExactSource": false,
      "logging": {
        "moduleLoad": true,
        "engineLogging": true
      }
    }
  ]
}
